# =============================================================================
# Florisyn public launch — copy to Netlify Environment variables (never commit secrets)
# =============================================================================

# --- Required: Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only (never expose in public/ or browser bundles):
SUPABASE_SERVICE_ROLE_KEY=
# Optional aliases if you migrated off legacy keys:
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Required: site origin (no trailing slash) ---
SITE_URL=https://www.florisyn.com

# --- Required: platform admin bootstrap (generate a long random string) ---
PLATFORM_BOOTSTRAP_SECRET=

# --- Required for card payments, subscriptions, marketplace, wire settlement ---
STRIPE_SECRET_KEY=
# Order checkout + marketplace + Florist Network wire payments:
STRIPE_ORDER_WEBHOOK_SECRET=
# Florisyn subscription billing (Starter / Pro / Premium):
STRIPE_WEBHOOK_SECRET=
# Stripe Connect (marketplace sellers + Florist Network wire payouts):
STRIPE_CONNECT_CLIENT_ID=

# --- Stripe Price IDs (create in Stripe Dashboard → Products) ---
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_PREMIUM_ANNUAL=

# --- Email campaigns (Resend) — required for Email Campaigns send ---
RESEND_API_KEY=

# --- Optional: delivery route distance (graceful degrade if missing) ---
GOOGLE_MAPS_API_KEY=

# --- Optional: cloud AI for Lily (local bridge works without these) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# --- Marketplace platform fee (percent); Florist Network wires stay $0 Florisyn fee ---
BLOOM_MARKETPLACE_FEE_PERCENT=5

# --- Feature flags (defaults are ON for launch; set false only to kill-switch) ---
# FLORISYN_FLAG_COMMUNITY_BETA=false
# FLORISYN_FLAG_FLORIST_NETWORK=false
# FLORISYN_FLAG_HOLIDAY_COMMAND_CENTER=false
# FLORISYN_FLAG_EMAIL_CAMPAIGNS=false
# FLORISYN_FLAG_WEDDING_WORKFLOWS=false

# --- Local dev only — never in production ---
# FLORISYN_ALLOW_OPEN_BOOTSTRAP=true
