{
  "name": "Florisyn / Bloom",
  "install": "npm ci && npm --prefix frontend ci",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "frontend-dev",
      "command": "npm --prefix frontend run dev -- --host 0.0.0.0",
