# Copy this file to .env and fill in the values below.
# `.env` is git-ignored — never commit real Stripe keys.

# --- Required -----------------------------------------------------------

# Your Stripe *secret* key (test mode while you're building this out).
# Find it at https://dashboard.stripe.com/test/apikeys
# The app refuses to start without a real value here — see src/stripeClient.js.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# --- Required to receive Connect account webhooks -----------------------

# The signing secret Stripe gives you for the webhook destination you
# create. If you're testing locally with the Stripe CLI, run:
#   stripe listen --thin-events \
#     "v2.core.account[requirements].updated,v2.core.account[configuration.recipient].capability_status_updated" \
#     --forward-thin-to http://localhost:4242/webhook
# and paste the "whsec_..." value it prints here. In the Dashboard, it's
# shown once when you create the event destination.
# Only POST /webhook checks this — every other route works without it.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Optional (sensible defaults if omitted) -----------------------------

# Where this server is reachable from a browser. Used to build the
# onboarding return/refresh URLs and the checkout success URL.
APP_URL=http://localhost:4242

# Port the sample listens on.
PORT=4242

# The platform's cut of every sale, in basis points (1/100th of a
# percent). 1000 = 10%. Applied via Checkout's application_fee_amount.
PLATFORM_FEE_BPS=1000
